{
  "schema": 1,
  "protocol": 1,
  "doc": "docs/mod-protocol.md#commands; this file is the table in machine form (docs/mod.md#11-build-and-test): the mod's argument checks and busy rules read it, the harness's protocol fake is generated from it, and tests keep the doc's table in step",
  "argKeys": "type (string, integer, number, boolean, object, array, id), required, default, min and max (inclusive), gt (exclusive minimum), minLength and maxLength (characters), values (the allowed strings)",
  "resultTypes": "string, integer, number, boolean, object, array, id; `|null` admits null",
  "common": {
    "frameIndex": "integer",
    "sinceReload": "integer|null",
    "qpcNs": "integer"
  },
  "commonNote": "every result and event carries these at answer time (docs/mod-protocol.md#envelope); sinceReload is null until the Iris adapter reads SystemTimeUniforms.COUNTER (0.01.07)",
  "errors": [
    "bad-json",
    "bad-encoding",
    "line-too-long",
    "bad-request",
    "unknown-command",
    "unsupported",
    "unauthenticated",
    "not-ready",
    "busy",
    "timeout",
    "cancelled",
    "iris-compile-error",
    "failed"
  ],
