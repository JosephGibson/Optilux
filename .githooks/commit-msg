#!/bin/sh
# Git commit-msg hook: optilux.hooks commit_msg judges the message (docs/workflow.md#hooks-and-guards).
# The venv beside these hooks runs them; git passes the message file, relative to the root.
here=$(cd "$(dirname "$0")/.." && pwd)
py="$here/.venv/Scripts/python.exe"
[ -x "$py" ] || py="$here/.venv/bin/python"
[ -x "$py" ] || { echo "commit-msg: no venv in $here; run \`uv sync\` there" >&2; exit 1; }
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" && exec "$py" -m optilux.hooks commit_msg "$1"
